# ERP AGEROUTE — variables d'environnement
# Copier en .env et remplir. NE JAMAIS committer le .env réel.

NODE_ENV=production
PORT=4001

# Base de données
POSTGRES_DB=erp_ageroute
POSTGRES_USER=erpuser
POSTGRES_PASSWORD=__A_GENERER__
DATABASE_URL=postgresql://erpuser:__A_GENERER__@erp-db:5432/erp_ageroute

# Secrets JWT — générer avec: openssl rand -base64 48
# NE PAS utiliser de valeur "parlante" ou devinable.
JWT_SECRET=__A_GENERER__
JWT_REFRESH_SECRET=__A_GENERER__

# Origines autorisées (CORS), séparées par des virgules
CORS_ORIGIN=https://gestion.ageroute.gov.gn,https://ageroutegn.sharepoint.com

# Messagerie
SMTP_HOST=ageroute-gov-gn.mail.protection.outlook.com
SMTP_PORT=25
SMTP_FROM=ERP AGEROUTE <noreply@ageroute.gov.gn>

# Référentiel routier (géoportail BDRI)
GEOPORTAIL_URL=https://carte.ageroute.gov.gn

# Stockage des pièces jointes (doit être un volume Docker persistant)
UPLOAD_DIR=/app/uploads
